# Copy to .env.local for development, or set in the environment for production.

# Secret used to sign session cookies. REQUIRED in production (>= 16 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional: override the seeded admin account (used only on first run, empty store).
# SEED_ADMIN_EMAIL=test@laviuda.com
# SEED_ADMIN_PASSWORD=test12345
