# Copy to .env.local for development, or set in the environment for production.

# Secret used to sign session cookies. REQUIRED in production (>= 16 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Firestore (project la-viuda-ec1be). When set, data lives in Firestore instead of
# data/*.json. Value: the service-account JSON on ONE line (Firebase console >
# Project settings > Service accounts > Generate new private key).
# FIREBASE_SERVICE_ACCOUNT=

# WhatsApp alert on each new reservation request (via CallMeBot). Phone in
# international format without "+", e.g. 59899156367. Get the key by messaging
# the CallMeBot number as described at callmebot.com/blog/free-api-whatsapp-messages/
# WHATSAPP_NOTIFY_PHONE=
# CALLMEBOT_APIKEY=

# Optional: override the seeded admin account (used only on first run, empty store).
# SEED_ADMIN_EMAIL=test@laviuda.com
# SEED_ADMIN_PASSWORD=test12345
